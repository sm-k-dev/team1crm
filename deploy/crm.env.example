# Example for future EC2/systemd deployment only. DO NOT put real credentials in Git.
# The UI-only starter does not currently use DB/AI/JWT/S3 settings.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
DB_URL=jdbc:mysql://localhost:3306/crm?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=replace_me
APP_STORAGE=s3
S3_BUCKET=replace_me
AWS_REGION=ap-northeast-2
