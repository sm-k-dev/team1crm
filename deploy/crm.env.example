# Copy to /home/ubuntu/crm/crm.env on the server and chmod 600.
# systemd reads this file; Spring Boot does not automatically load .env files.
# Manage the profile here only. Replace DB values before starting the service.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
DB_URL=jdbc:mysql://localhost:3306/crm?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=replace_me
DB_PASSWORD=replace_me
# AI/JWT/S3 settings are not connected yet; add them when implemented.
# 고객 주요 정보 제거 배치: DB 스키마 적용 후 true로 변경
CUSTOMER_PRIVACY_ENABLED=false
CUSTOMER_PRIVACY_CRON="0 0 3 * * *"
